# Credentials Configuration for UC Automation
# ==================================================
#
# Format: [SERVICE:identifier]
# Services: CUCM, CUC, CUBE
#
# Password handling:
#   - Leave password blank to prompt at runtime
#   - Set password=<value> to use stored credential (not recommended for prod)
#   - Scripts respect this setting and will prompt if blank
#
# All entries are optional - only define what you need.

# ========== CUCM CLUSTERS ==========
# Each CUCM cluster needs: server, username, password, version

[CUCM:cucm1]
server=192.168.10.100
username=axl_user
password=
version=15.0

[CUCM:cucm2]
server=192.168.10.101
username=axl_user
password=
version=15.0

# ========== CUC CLUSTERS ==========
# Each CUC cluster needs: server, username, password, version

[CUC:cuc1]
server=192.168.10.120
username=admin
password=
version=15.0

[CUC:cuc2]
server=192.168.10.121
username=admin
password=
version=15.0

# ========== CUBE DEVICES ==========
# Router IPs and names come from routers.csv
# Credentials.env contains only usernames and passwords
#
# Two modes:
#   [CUBE:default] - Single username/password for all routers (used if only entry)
#   [CUBE:hostname] - Per-router credentials, matched by hostname from CSV
#
# Examples below match the hostnames in routers.csv

[CUBE:default]
username=admin
password=

[CUBE:aawoods-vg-8000v]
username=admin
password=

[CUBE:aw-slab42-lg]
username=admin
password=

# ========== WEBEX CLUSTERS ==========
# Webex uses OAuth and API tokens instead of username/password

[WEBEX:webex1]
# API token for Webex admin API
api_token=
# Optional: Org ID if not in token
org_id=
