# Credentials Configuration for UC Automation
# ==================================================
#
# Format: [SERVICE:identifier]
# Services: CUCM, CUC, CUBE, WEBEX
#
# All cluster/device names, servers, and versions come from CSV files:
#   - clusters.csv: CUCM and CUC cluster definitions (name, server, version)
#   - routers.csv: CUBE router definitions (router_ip, hostname)
#
# This file contains ONLY credentials (usernames, passwords, bearer tokens).
#
# Credential Resolution Strategy:
#   1. Scripts load cluster info from clusters.csv, which includes cluster_name
#   2. Script tries to load credentials using cluster_name (e.g., CUCM:CUCM1)
#   3. If cluster-specific credentials not found, falls back to [SERVICE:default]
#   4. If default credentials not found, prompts user interactively
#
# Credential Modes:
#   [SERVICE:default] - Fallback for all clusters/devices (required)
#   [SERVICE:cluster_name] - Per-cluster credentials (optional, overrides default)
#
# Example: If clusters.csv has cluster_name=CUCM1:
#   - Script first looks for [CUCM:CUCM1]
#   - If not found, uses [CUCM:default]
#   - If neither found, prompts for credentials
#
# Password Handling:
#   - Leave password blank to prompt at runtime (recommended)
#   - Set password=<value> to use stored credential (not recommended for prod)

# ========== CUCM CREDENTIALS ==========
# Usernames/passwords for CUCM clusters defined in clusters.csv
# Use [CUCM:default] as fallback for all clusters
# Use [CUCM:cluster_name] to override for specific clusters (e.g., CUCM:CUCM1)

[CUCM:default]
username=axl_user
password=

# Per-cluster overrides (optional, uses default if not specified)
[CUCM:CUCM1]
username=axl_user
password=

[CUCM:CUCM2]
username=axl_user_alternate
password=

# ========== CUC CREDENTIALS ==========
# Usernames/passwords for CUC clusters defined in clusters.csv
# Use [CUC:default] as fallback for all clusters
# Use [CUC:cluster_name] to override for specific clusters (e.g., CUC:CUC1)

[CUC:default]
username=admin
password=

# Per-cluster overrides (optional, uses default if not specified)
[CUC:CUC1]
username=admin
password=

[CUC:CUC2]
username=admin_prod
password=

# ========== CUBE CREDENTIALS ==========
# Usernames/passwords for CUBE routers defined in routers.csv
# Use [CUBE:default] as fallback for all routers
# Use [CUBE:hostname] to override for specific routers
# Hostname should match the hostname column in routers.csv

[CUBE:default]
username=admin
password=

# Per-router overrides (optional, uses default if not specified)
[CUBE:aawoods-vg-8000v]
username=admin
password=

[CUBE:aw-slab42-lg]
username=admin
password=

# ========== WEBEX CREDENTIALS ==========
# API tokens for Webex integrations

[WEBEX:default]
api_token=
