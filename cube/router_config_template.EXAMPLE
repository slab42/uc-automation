! Example Voice Configuration Template
! This template contains voice sections to compare against.
! Include only the sections and commands you want to validate.
! Sections not present in this template will be ignored in router configs.

voice class codec 1
  codec preference 1 g729
  codec preference 2 g711ulaw

voice-port 0/0/0
  description PRI-Line-1
  signal-protocol dnis
  caller-id enable

voice-port 0/0/1
  description PRI-Line-2
  signal-protocol dnis

dial-peer voice 1 pots
  description Outbound-Route-1
  destination-pattern 9011T
  port 0/0/0

dial-peer voice 2 pots
  description Outbound-Route-2
  destination-pattern 9T
  port 0/0/1

dial-peer voice 100 voip
  description Inbound-Route
  destination-pattern 3..
  session protocol sip
  session target ipv4:10.0.0.1
  dtmf-relay sip-kpml

call-manager-fallback
  max-ephones 10
  max-dn 20
  ip source-address 192.168.1.1 port 2000

telephony-service
  max-ephones 10
  max-dn 20
  ip source-address 192.168.1.1 port 2000
  service sms
  service phone-to-phone-conference
