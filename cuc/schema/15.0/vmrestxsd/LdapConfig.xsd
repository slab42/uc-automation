<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">          
        <xs:complexType name="LdapConfig">
                <xs:sequence>
                        <xs:element name="name" type="xs:string" minOccurs="0"/>
			<xs:element name="pkid" type="xs:string" minOccurs="0"/>
                        <xs:element name="ldapdn" type="xs:string" minOccurs="0"/>
                        <xs:element name="ldappassword" type="xs:string" minOccurs="0"/>
                        <xs:element name="userbase" type="xs:string" minOccurs="0"/>
                        <xs:element name="hostname" type="xs:string" minOccurs="0"/>
                        <xs:element name="portnumber" type="xs:int" minOccurs="0"/>
			<xs:element name="sslenabled" type="xs:boolean" minOccurs="0"/>
                	<xs:element name="repeatable" type="xs:boolean" minOccurs="0"/>
			<xs:element name="internalvalue" type="xs:int" minOccurs="0"/>
			<xs:element name="tkscheduleunit" type="xs:long" minOccurs="0"/>
			<xs:element name="nextexectime" type="xs:string" minOccurs="0"/>
		</xs:sequence>
        </xs:complexType>
        <xs:element name="LdapConfig" type="LdapConfig"/>
        <xs:element name="LdapConfigs">
                <xs:complexType>
                        <xs:sequence>
                                <xs:element name="LdapConfig" type="LdapConfig" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="total" type="xs:int"/>
                </xs:complexType>
        </xs:element>   
</xs:schema>


